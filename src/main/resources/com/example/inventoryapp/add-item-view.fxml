<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.inventoryapp.AddItemController">
    <Label layoutX="14.0" layoutY="14.0" text="Select Item Type:"/>
    <ChoiceBox fx:id="itemTypeChoiceBox" layoutX="14.0" layoutY="40.0" prefWidth="150.0"/>

    <Label layoutX="14.0" layoutY="80.0" text="Name:"/>
    <TextField fx:id="nameField" layoutX="14.0" layoutY="100.0" prefWidth="200.0"/>

    <Label layoutX="14.0" layoutY="140.0" text="Value:"/>
    <TextField fx:id="valueField" layoutX="14.0" layoutY="160.0" prefWidth="100.0"/>

    <Label layoutX="14.0" layoutY="200.0" text="Weight:"/>
    <TextField fx:id="weightField" layoutX="14.0" layoutY="220.0" prefWidth="100.0"/>

    <Label fx:id="specialAttributeLabel" layoutX="14.0" layoutY="260.0" text="Special Attribute:"/>
    <TextField fx:id="specialAttributeField" layoutX="14.0" layoutY="280.0" prefWidth="100.0"/>

    <Button layoutX="14.0" layoutY="330.0" text="Add Item" onAction="#handleAddItem"/>
    <Button layoutX="100.0" layoutY="330.0" text="Cancel" onAction="#handleCancel"/>
</AnchorPane>
