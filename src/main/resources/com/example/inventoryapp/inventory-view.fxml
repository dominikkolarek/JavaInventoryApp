<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="634.0" prefWidth="709.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.inventoryapp.InventoryController">
  <children>

    <Button layoutX="23.0" layoutY="165.0" onAction="#handleShowAll" text="All" />
    <Button layoutX="25.0" layoutY="205.0" onAction="#handleShowWeapons" text="Weapons" />
    <Button layoutX="23.0" layoutY="248.0" onAction="#handleShowArmor" text="Armor" />
    <Button layoutX="25.0" layoutY="292.0" onAction="#handleShowPotions" text="Potions" />

    <ListView fx:id="inventoryListView" layoutX="110.0" layoutY="63.0" prefHeight="370" prefWidth="179.0" />

    <Button layoutX="323.0" layoutY="63.0" onAction="#handleUseItem" text="Equip/Use" />
    <Button layoutX="323.0" layoutY="98.0" onAction="#handleUnequipItem" text="Unequip" />
    <Button layoutX="332.0" layoutY="503.0" onAction="#handleTakeDamage" text="Take Damage" />
    <Button layoutX="326.0" layoutY="133.0" onAction="#handleAddItem" text="Add Item" />
    <Button layoutX="327.0" layoutY="165.0" onAction="#handleEditItem" text="Edit Item" />
    <Button layoutX="326.0" layoutY="199.0" onAction="#handleDeleteItem" text="Delete Item" />

    <Label layoutX="471.0" layoutY="498.0" text="Stats:" />
    <Label fx:id="statsLabel" layoutX="471.0" layoutY="498.0" prefHeight="106.0" prefWidth="207.0" />
    <TextArea fx:id="itemStatsTextArea" editable="false" layoutX="376.0" layoutY="317.0" prefHeight="106.0" prefWidth="302.0" wrapText="true" />
  </children>
   <effect>
      <Blend mode="BLUE" />
   </effect>
   <cursor>
      <Cursor fx:constant="DEFAULT" />
   </cursor>
</AnchorPane>
